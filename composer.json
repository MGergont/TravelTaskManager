{
    "name": "TravelTaskManager/projekt",
    "version": "1.0.1",
    "description": "TravelTaskManager is a comprehensive web application supporting business travel management in enterprises. It enables effective expense recording, route planning, fleet management and employee task assignment.",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Src\\": "Src/",
            "Script\\": "Script/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "robmorgan/phinx": "^0.16.10"
    },
    "scripts": {
        "app:check-db": [
        "php Script/checkDBConnection.php"
        ],
        "app:init": [
        "@app:check-db",
        "php Script/createDB.php",
        "php vendor/bin/phinx migrate -e production"
        ],
        "app:update": [
        "git pull",
        "composer install"
        ],
        "app:update-db": [
        "@app:check-db",
        "php vendor/bin/phinx migrate -e production"
        ]
  }
}
